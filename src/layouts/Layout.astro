---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Andres Godinez · Automatización con IA',
  description = 'Agentes de IA, chatbots y automatización para PYMES y agencias. Vende más y trabaja menos.',
  canonical = 'https://automatiza.aandresdev.com/',
} = Astro.props;

const ogImage = 'https://automatiza.aandresdev.com/assets/andres-light.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Andres Godinez — Automatización con IA',
  description: 'Agentes de IA, chatbots y automatización para PYMES y agencias.',
  url: 'https://automatiza.aandresdev.com/',
  image: ogImage,
  areaServed: 'Worldwide',
  founder: { '@type': 'Person', name: 'Andres Godinez' },
  sameAs: [],
};

const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230a0805'/%3E%3Ctext x='50' y='78' font-family='system-ui,sans-serif' font-weight='900' font-size='86' text-anchor='middle' fill='%23F2A33C'%3Ea%3C/text%3E%3C/svg%3E";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Andres Godinez">
  <meta name="keywords" content="automatización con IA, inteligencia artificial para negocios, automatización PYMES, chatbots IA, agentes de IA, n8n, Andres Godinez">
  <meta name="theme-color" content="#0a0805">
  <link rel="canonical" href={canonical}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="3018">
  <meta property="og:image:height" content="4026">
  <meta property="og:image:alt" content="Andres Godinez — Automatización con IA">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Andres Godinez">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="icon" type="image/svg+xml" href={favicon}>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=DM+Serif+Display&display=swap" rel="stylesheet">
</head>
<body>
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="bg-glow" aria-hidden="true"></div>

  <slot />
</body>
</html>
