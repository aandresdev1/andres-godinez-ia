---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { findResource, CATEGORY_META, formatDate } from '../data/resources.js';

export const prerender = false;

const { slug } = Astro.params;
const resource = slug ? findResource(slug) : null;

if (!resource) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const meta = CATEGORY_META[resource.category] || { color: '#ccc', bg: 'rgba(255,255,255,0.08)' };
const canonical = `https://automatiza.aandresdev.com/${resource.slug}`;
---
<Layout
  title={`${resource.title} · Andres Godinez`}
  description={resource.description}
  canonical={canonical}
>
  <Header />
  <main class="recursos-main">
    <a href="/recursos" class="detail-back">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Volver a recursos
    </a>

    <section class="detail-head">
      <span class="resource-cat-badge" style={`color:${meta.color}; background:${meta.bg};`}>{resource.category}</span>
      <h1 class="detail-title">{resource.title}</h1>
      <div class="detail-meta">
        <span>{formatDate(resource.date)}</span>
        {resource.tiktok && (
          <a href={resource.tiktok} target="_blank" rel="noopener" class="detail-tiktok">Ver el video en TikTok →</a>
        )}
      </div>
      <p class="detail-desc">{resource.description}</p>
    </section>

    {resource.gated && (
      <section class="gate-inline" id="gateInline" hidden>
        <div class="gate-inline-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        </div>
        <div class="gate-inline-title">Este recurso llega por correo</div>
        <div class="gate-inline-text">Te lo mando al correo. De paso te llegan los recursos nuevos, y te puedes salir cuando quieras.</div>
        <div class="gate-inline-form">
          <input type="email" id="gateInlineEmail" placeholder="tu@correo.com" class="gate-input" autocomplete="email">
          <button type="button" id="gateInlineSubmit" class="btn-primary">Enviármelo</button>
        </div>
        <div class="gate-inline-error" id="gateInlineError" hidden></div>
        <div class="gate-inline-fine">Sin spam. Un correo por semana como máximo.</div>
      </section>
    )}

    <section class="detail-content" id="detailContent" data-gated={resource.gated ? 'true' : 'false'}>
      {resource.delivery === 'prompt' && resource.content && (
        <div class="detail-code">
          <div class="detail-code-head">
            <span class="detail-code-lang">prompt</span>
            <button type="button" id="copyPromptBtn" class="detail-code-copy" data-copy={resource.content}>Copiar</button>
          </div>
          <pre class="detail-pre"><code>{resource.content}</code></pre>
        </div>
      )}

      {resource.bodyParagraphs?.map((p) => <p class="detail-p">{p}</p>)}

      {resource.contents && resource.contents.length > 0 && (
        <>
          <h3 class="detail-h3">Qué incluye</h3>
          <ul class="detail-list">
            {resource.contents.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
    </section>

    <section class="recursos-cta">
      <div class="cta-box">
        <div class="cta-glow" aria-hidden="true"></div>
        <div class="recursos-cta-inner">
          <div>
            <h2>¿Tienes un negocio y quieres algo así?</h2>
            <p class="lead">Hablemos de cómo automatizar tu operación con IA — sin compromiso.</p>
          </div>
          <a href="/#contacto" class="btn-primary btn-lg">Escríbeme →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  (function () {
    var btn = document.getElementById('copyPromptBtn');
    if (btn) {
      btn.addEventListener('click', function () {
        var text = btn.dataset.copy || '';
        var doneCopy = function () {
          var original = btn.textContent;
          btn.textContent = 'Copiado';
          btn.classList.add('is-copied');
          setTimeout(function () {
            btn.textContent = original;
            btn.classList.remove('is-copied');
          }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(doneCopy).catch(function (e) { console.error('copy failed', e); });
        } else {
          doneCopy();
        }
      });
    }

    var STORAGE_KEY = 'andres_recursos_subscribed';
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    var content = document.getElementById('detailContent');
    var gateInline = document.getElementById('gateInline');

    function isSubscribed() {
      try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; }
    }

    if (content && content.dataset.gated === 'true' && gateInline) {
      if (isSubscribed()) {
        gateInline.hidden = true;
        content.style.display = '';
      } else {
        gateInline.hidden = false;
        content.style.display = 'none';
      }
    }

    var gateEmail = document.getElementById('gateInlineEmail');
    var gateSubmit = document.getElementById('gateInlineSubmit');
    var gateError = document.getElementById('gateInlineError');

    function submitInlineGate() {
      if (!gateEmail || !gateError) return;
      var email = gateEmail.value.trim();
      if (!EMAIL_RE.test(email)) {
        gateError.textContent = 'Ese correo no parece válido.';
        gateError.hidden = false;
        return;
      }
      try {
        localStorage.setItem(STORAGE_KEY, '1');
        localStorage.setItem('andres_recursos_email', email);
      } catch (e) {}
      if (gateInline) gateInline.hidden = true;
      if (content) content.style.display = '';
    }

    if (gateSubmit) gateSubmit.addEventListener('click', submitInlineGate);
    if (gateEmail) gateEmail.addEventListener('keydown', function (e) { if (e.key === 'Enter') submitInlineGate(); });
  })();
</script>
