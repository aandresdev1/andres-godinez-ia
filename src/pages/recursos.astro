---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { CHIP_LIST } from '../data/resources.js';

export const prerender = false;

const entries = await getCollection('resources');
const sorted = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = sorted[0];
const rest = sorted.slice(1);
const total = sorted.length;

const usedCategories = new Set(sorted.map((r) => r.category));
const visibleChips = CHIP_LIST.filter((c) => c === 'Todos' || usedCategories.has(c));
---
<Layout
  title="Recursos gratis · Andres Godinez"
  description="Prompts, automatizaciones, guías y plantillas gratis para automatizar tu negocio con IA."
  canonical="https://automatiza.aandresdev.com/recursos"
>
  <Header />
  <main class="recursos-main">
    <section class="recursos-hero">
      <div class="eyebrow">RECURSOS GRATIS</div>
      <h1>Todo lo que menciono <span class="accent">en mis videos</span></h1>
      <p class="recursos-subtitle">
        {total} recursos gratis para automatizar tu negocio y crear mejor contenido.
      </p>
    </section>

    <section class="recursos-chips">
      <div class="chip-row" role="tablist" aria-label="Categorías">
        {visibleChips.map((cat, i) => (
          <button
            type="button"
            class:list={['chip', { 'is-active': i === 0 }]}
            data-chip={cat}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>
    </section>

    <section class="recursos-featured">
      <ResourceCard resource={featured} featured />
    </section>

    {rest.length > 0 && (
      <section class="recursos-grid-section">
        <div class="recursos-grid">
          {rest.map((r) => <ResourceCard resource={r} />)}
        </div>
        <div class="recursos-empty" hidden>
          <div class="recursos-empty-title">Todavía no hay nada aquí</div>
          <div class="recursos-empty-text">Pronto sumo recursos en esta categoría — vuelve a pasar.</div>
        </div>
      </section>
    )}

    <section class="recursos-cta">
      <div class="cta-box">
        <div class="cta-glow" aria-hidden="true"></div>
        <div class="recursos-cta-inner">
          <div>
            <h2>¿Tienes un negocio y quieres algo así?</h2>
            <p class="lead">Hablemos de cómo automatizar tu operación con IA — sin compromiso.</p>
          </div>
          <a href="/#contacto" class="btn-primary btn-lg">Escríbeme →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <div class="gate-overlay" id="gateOverlay" hidden>
    <div class="gate-modal" role="dialog" aria-modal="true" aria-labelledby="gateTitle">
      <button type="button" class="gate-close" id="gateClose" aria-label="Cerrar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div id="gateForm">
        <div class="gate-eyebrow">CONTENIDO EXCLUSIVO</div>
        <div class="gate-title" id="gateTitle">Suscríbete para ver este material</div>
        <div class="gate-tone">Es necesario que te suscribas al newsletter para ver este material.</div>
        <input type="email" id="gateEmail" placeholder="tu@correo.com" class="gate-input" autocomplete="email">
        <div class="gate-error" id="gateError" hidden></div>
        <button type="button" id="gateSubmit" class="btn-primary btn-block">Suscribirme al newsletter</button>
        <div class="gate-fine">Sin spam. Cancela cuando quieras.</div>
      </div>

      <div id="gateSuccess" hidden>
        <div class="gate-success-icon">✓</div>
        <div class="gate-success-title">¡Listo, ya estás suscrito!</div>
        <div class="gate-success-text">Ya tienes acceso a todos los recursos exclusivos.</div>
        <button type="button" id="gateDone" class="btn-primary btn-block">Ver el recurso</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip[data-chip]');
    var cards = document.querySelectorAll('.recursos-grid .resource-card');
    var featured = document.querySelector('.recursos-featured');
    var empty = document.querySelector('.recursos-empty');
    var grid = document.querySelector('.recursos-grid');

    function applyFilter(cat) {
      var visible = 0;
      cards.forEach(function (c) {
        var match = cat === 'Todos' || c.dataset.category === cat;
        c.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (featured) featured.style.display = cat === 'Todos' ? '' : 'none';
      if (empty && grid) {
        var showEmpty = cat !== 'Todos' && visible === 0;
        empty.hidden = !showEmpty;
        grid.style.display = showEmpty ? 'none' : '';
      }
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-selected', 'true');
        applyFilter(chip.dataset.chip);
      });
    });

    var STORAGE_KEY = 'andres_recursos_subscribed';
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var NEWSLETTER_WEBHOOK = 'https://primary-production-b62f1.up.railway.app/webhook/newsletter-notion';

    function postSubscription(email, slug) {
      try {
        fetch(NEWSLETTER_WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, slug: slug || '' }),
          keepalive: true
        }).catch(function () {});
      } catch (e) {}
    }

    var overlay = document.getElementById('gateOverlay');
    var closeBtn = document.getElementById('gateClose');
    var formPane = document.getElementById('gateForm');
    var successPane = document.getElementById('gateSuccess');
    var titleEl = document.getElementById('gateTitle');
    var emailInput = document.getElementById('gateEmail');
    var errorEl = document.getElementById('gateError');
    var submitBtn = document.getElementById('gateSubmit');
    var doneBtn = document.getElementById('gateDone');

    var pendingSlug = null;

    function isSubscribed() {
      try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; }
    }
    function markSubscribed(email) {
      try {
        localStorage.setItem(STORAGE_KEY, '1');
        localStorage.setItem('andres_recursos_email', email);
      } catch (e) {}
    }

    function openGate(slug, title) {
      if (!overlay || !formPane || !successPane || !titleEl) return;
      pendingSlug = slug;
      titleEl.textContent = title || 'Suscríbete para ver este material';
      formPane.hidden = false;
      successPane.hidden = true;
      if (emailInput) emailInput.value = '';
      if (errorEl) errorEl.hidden = true;
      overlay.hidden = false;
      requestAnimationFrame(function () { overlay.classList.add('is-open'); });
      document.body.style.overflow = 'hidden';
      setTimeout(function () { if (emailInput) emailInput.focus(); }, 120);
    }
    function closeGate() {
      if (!overlay) return;
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { overlay.hidden = true; }, 200);
    }

    function submitGate() {
      if (!emailInput || !errorEl || !formPane || !successPane) return;
      var email = emailInput.value.trim();
      if (!EMAIL_RE.test(email)) {
        errorEl.textContent = 'Ese correo no parece válido.';
        errorEl.hidden = false;
        return;
      }
      errorEl.hidden = true;
      markSubscribed(email);
      postSubscription(email, pendingSlug);
      formPane.hidden = true;
      successPane.hidden = false;
    }

    if (submitBtn) submitBtn.addEventListener('click', submitGate);
    if (emailInput) emailInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') submitGate(); });
    if (closeBtn) closeBtn.addEventListener('click', closeGate);
    if (overlay) overlay.addEventListener('click', function (e) { if (e.target === overlay) closeGate(); });
    if (doneBtn) doneBtn.addEventListener('click', function () {
      if (pendingSlug) window.location.href = '/' + pendingSlug;
      else closeGate();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay && !overlay.hidden) closeGate();
    });

    document.querySelectorAll('.resource-card[data-gated="true"]').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (isSubscribed()) return;
        e.preventDefault();
        openGate(card.dataset.slug || '', card.dataset.title || '');
      });
    });
  })();
</script>
